{
    "name": "2amigos/qrcode-library",
    "description": "QrCode Generator",
    "type": "library",
    "keywords": [
        "2amigos",
        "extension",
        "component",
        "qrcode",
        "qr"
    ],
    "homepage": "https://2am.tech/our-work/open-source/qrcode-library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "2amigOS! Consulting Group",
            "email": "hola@2amigos.us",
            "homepage": "https://2am.tech",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/2amigos/qrcode-library/issues",
        "source": "https://github.com/2amigos/qrcode-library"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "ext-simplexml": "*",
        "bacon/bacon-qr-code": "^3.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "phpmd/phpmd": "^2.15",
        "codeception/codeception": "^5.1",
        "codeception/module-asserts": "^3.0",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^2.0",
        "codeception/module-laravel": "^3.2",
        "codeception/specify": "^2.0",
        "codeception/verify": "^3.0",
        "yiisoft/yii2": "^2.0.52",
        "laravel/framework": "^12.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8",
        "psr/http-server-handler": "^1.0"
    },
    "suggest": {
        "ext-imagick": "To render QR codes with the ImageMagick backend instead of the default GD backend",
        "yiisoft/yii2": "To use the Yii2 QrCode component and action",
        "laravel/framework": "To use the Laravel QrCode blade component, service provider and factory",
        "psr/http-message": "To use the framework-agnostic PSR-15 Da\\QrCode\\Bridge\\Psr\\QrCodeAction (Yii3, Mezzio, Slim, ...)",
        "psr/http-factory": "Provides the PSR-17 factories required by the PSR-15 Da\\QrCode\\Bridge\\Psr\\QrCodeAction",
        "psr/http-server-handler": "Provides the PSR-15 RequestHandlerInterface implemented by Da\\QrCode\\Bridge\\Psr\\QrCodeAction"
    },
    "autoload": {
        "psr-4": {
            "Da\\QrCode\\": "./src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0-dev"
        },
        "laravel": {
            "providers": [
                "Da\\QrCode\\Bridge\\Laravel\\QrCodeServiceProvider"
            ]
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "md": "phpmd src text phpmd.xml",
        "test": "codecept run"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
