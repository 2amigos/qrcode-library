includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
    # The pre-existing src/ code reports 134 findings at level 6 (mostly
    # GdImage-vs-resource and missing iterable/parameter types). They are
    # captured in phpstan-baseline.neon so CI stays green while new code is
    # held to level 6. Remove entries from the baseline as the code is typed.
    parallel:
        # Keep memory in check; the default 128M limit crashes the workers.
        maximumNumberOfProcesses: 4
